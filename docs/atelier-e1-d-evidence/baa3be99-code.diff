+/**
+ * Format a cent amount using the Quebec Canadian-dollar convention.
+ * @param {number} cents
+ * @returns {string}
+ */
+export function formatCanadianDollars(cents) {
+  assertCents(cents, 'cents');
+
+  return new Intl.NumberFormat('fr-CA', {
+    style: 'currency',
+    currency: 'CAD',
+    currencyDisplay: 'symbol',
+  }).format(cents / 100).replace(/\u00a0/g, ' ');
+}
