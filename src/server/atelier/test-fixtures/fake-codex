#!/bin/sh
# Fake subscription Codex CLI for tests: no network, no model.
if [ "$1" = "login" ]; then echo "Logged in using ChatGPT"; exit 0; fi
if [ "$1" = "auth" ]; then echo '{"loggedIn":true,"authMethod":"claude.ai","apiProvider":"firstParty"}'; exit 0; fi
cat >/dev/null
# Test knobs come from a file: the runner passes only an allowlisted environment.
[ -f "$HOME/fake.env" ] && . "$HOME/fake.env"
SID=${FAKE_SID:-11111111-2222-3333-4444-555555555555}
for a in "$@"; do case "$a" in ????????-????-????-????-????????????) SID=$a;; esac; done
MODEL=$(echo "$@" | sed -n 's/.*-m \([^ ]*\).*/\1/p')
mkdir -p "$HOME/.codex/sessions/x"; echo "{\"model\":\"${FAKE_OBSERVED:-$MODEL}\"}" > "$HOME/.codex/sessions/x/rollout-$SID.jsonl"
echo "{\"type\":\"thread.started\",\"thread_id\":\"$SID\"}"
echo '{"type":"item.completed","item":{"type":"agent_message","text":"travail"}}'
[ -n "$FAKE_SLEEP" ] && sleep "$FAKE_SLEEP"
echo "step $$" >> work.txt
echo '{"type":"item.completed","item":{"type":"file_change","changes":[{"path":"work.txt"}]}}'
echo '{"type":"turn.completed","usage":{}}'
