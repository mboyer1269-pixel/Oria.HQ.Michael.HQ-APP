ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=

# ── Supabase ────────────────────────────────────────────────────────────────
# All three are REQUIRED in production — the app refuses to start without them
# (src/lib/server-env.ts). NEXT_PUBLIC_SUPABASE_ANON_KEY is not cosmetic: every
# authenticated route builds a server client from it, so without it the owner
# gate answers 401 to everything while the app otherwise looks healthy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner identity — REQUIRED in production (auth gating).
MICHAEL_HQ_OWNER_ID=
MICHAEL_HQ_OWNER_EMAIL=

# ── Dev single-user fallback ────────────────────────────────────────────────
# When MICHAEL_HQ_OWNER_ID is empty, the app uses a local dev single-user
# identity ("local-michael", in-memory storage). DEV / LOCAL ONLY.
# Outside production this fallback is allowed automatically. In production the
# app fail-closes (throws) when no real owner is configured — UNLESS you set
# the flag below to "true" to explicitly allow it (strongly discouraged).
# Leave empty for any real deployment.
ORIA_ALLOW_DEV_USER_FALLBACK=

# ── Document store (dev/test fixture) ───────────────────────────────────────
# db/documents.json is a LOCAL DEV/TEST fixture, not a production datastore.
# In production the file store is fail-closed (ignored). The real path is the
# Supabase `documents` table (db/schema.sql); see
# docs/migrations/documents-file-store-to-db.md.
# BREAK-GLASS / UNSAFE — never set in a normal production deployment. Setting
# this to "true" forces the file store ON in production and logs a loud warning.
ORIA_UNSAFE_ALLOW_FILE_DOCUMENT_STORE_IN_PROD=

# Durable archive directory for the document-processing CLI
# (src/scripts/process-document.ts) when filing "mcl"-classified files.
# REQUIRED for that script: it MOVES files, so there is no temp-dir fallback —
# it fails closed rather than relocate real documents to purgeable storage.
MCL_ARCHIVE_DIR=

CONTACT_NOTIFICATION_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Optional for local/single-instance. When set, the rate limiter uses Upstash
# Redis (atomic sliding-window, multi-instance safe).
# When absent, falls back to in-memory sliding-window (single-instance only).
# REQUIRED in production behind more than one instance: the in-memory fallback
# is per-instance, so limits under-count and the protection weakens. Production
# without these vars logs a one-time [rate-limit] warning (see src/lib/rate-limit.ts).
# Get credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Background Jobs (Inngest) ───────────────────────────────────────────────
# Needed in production for scheduled jobs to run at all. NOT boot-critical:
# their absence degrades that one rail and is reported by
# getProductionReadinessWarnings() rather than stopping the server.
# Leave empty for local dev (uses the Inngest dev server).
# Get keys at: https://app.inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Opt-in feature flags ────────────────────────────────────────────────────
# Each capability below is OFF unless its flag is exactly "1". Declared in the
# server-env schema so this file and the schema are one inventory.

# Read-only Memex context source for Joris. Requires BOTH: the flag and a path.
# Without MEMEX_CORE_ROOT the source reports "unavailable" and never spawns.
ORIA_ENABLE_MEMEX_READONLY=
MEMEX_CORE_ROOT=

# Optional remote read-only Memex, selected before stdio only when explicitly enabled.
# Fixed /mcp HTTPS URL (or explicit loopback HTTP tunnel), one HQ workspace.
# Handle must be signed, unexpired, read_only and scoped to exactly
# workspaceIdToMemexNamespace(MEMEX_HTTP_HQ_WORKSPACE_ID). Store it as a server secret.
ORIA_ENABLE_MEMEX_HTTP_READONLY=0
MEMEX_HTTP_ENDPOINT=
MEMEX_HTTP_READ_HANDLE=
MEMEX_HTTP_READ_HANDLE_FILE=
MEMEX_HTTP_HQ_WORKSPACE_ID=

# Separate opt-in contribution corridor; never reuse the read-only handle.
# Choose inline OR mounted file for each credential, not both.
ORIA_ENABLE_MEMEX_PROPOSALS=0
MEMEX_HTTP_PROPOSAL_HANDLE=
MEMEX_HTTP_PROPOSAL_HANDLE_FILE=
# Exact browser origin when deployed behind a proxy; no trailing slash/path.
ORIA_HQ_PUBLIC_ORIGIN=

# Local runtime probe (Claude Code / Codex / Gemini CLI detection). Spawns local
# commands, so a production build refuses unless this is explicitly "1".
ORIA_ENABLE_LOCAL_RUNTIME_PROBE=

# Flags read through a name constant rather than a literal property access.
# Each is OFF unless set to a truthy value ("1", "true", "yes", "on").

# Shadow-writes the ledger hash chain. Draft migration only — not live.
LEDGER_HASH_CHAIN_WRITE=
LEDGER_HMAC_KEY=

# Durable mission drafts. Draft migration only — not live.
MISSION_DURABLE_DRAFTS=

# Exposes the staging runtime diagnostic endpoint.
ENABLE_STAGING_RUNTIME_DIAGNOSTIC=

# Manual smoke only. Keep 0 unless smoke:joris should exercise real persistence.
SMOKE_WRITE=0

# Paperclip read-only pilot. Disabled unless exactly 1; no dispatch or queue writes.
# Origin only (no /api path, query, credentials). HTTPS, or HTTP on loopback only.
# Use a dedicated authenticated board identity limited to the configured company.
# Supply its token through the deployment secret store; never NEXT_PUBLIC_*.
ORIA_ENABLE_PAPERCLIP_READONLY=0
ORIA_ENABLE_PAPERCLIP_DISPATCH=0
PAPERCLIP_BASE_URL=
PAPERCLIP_BOARD_TOKEN=
# Exact canonical HQ workspace ID and Paperclip company UUID, resolved server-side.
PAPERCLIP_HQ_WORKSPACE_ID=
PAPERCLIP_COMPANY_ID=

# ── Agent Webhook Bridge — INERT, setting these changes nothing ─────────────
# These three per-agent URLs are read by NO code path. They date from a design
# where each agent had its own destination; the only dispatcher
# (n8n_webhook_trigger) resolves N8N_WEBHOOK_URL below, and the webhook registry
# now declares that same variable. Kept declared so an existing deployment does
# not fail validation — but do not expect them to route anything.
AGENT_MARKETING_WEBHOOK_URL=
AGENT_INVENTOR_WEBHOOK_URL=
AGENT_HERMES_WEBHOOK_URL=

# HMAC signing secret for the outbound dispatch body (x-orya-signature).
# This one IS read. Without it, a binding that requires a signature — all of
# them — refuses to dispatch.
AGENT_WEBHOOK_SIGNING_SECRET=

# ── n8n Execution Bridge (CEO-approval-gated) ───────────────────────────────
# Single destination for the n8n_webhook_trigger MCP tool. The webhook is fired
# ONLY when the CEO manually approves a queued execution intent — never from the
# automatic green-lane evaluation (humanOnTheLoop is absolute).
# N8N_SECRET is sent as the x-webhook-secret header (in addition to the HMAC
# signature) so n8n can verify the transfer. Leave empty in dev to keep the
# tool inert (it refuses to dispatch without both vars).
N8N_WEBHOOK_URL=
N8N_SECRET=

# Dedicated human-review operator corridor; never use agent handles here.
ORIA_ENABLE_MEMEX_REVIEW=0
MEMEX_REVIEW_ENDPOINT=
MEMEX_REVIEW_HQ_WORKSPACE_ID=
MEMEX_REVIEW_TOKEN_FILE=

# Prepare and confirm an OpenHands dossier; never launches an agent by itself.
ORIA_ENABLE_OPENHANDS_CONFIRMATION=0
ORIA_ENABLE_OPENHANDS_LAUNCH=0
# Pinned executor configuration JSON, server-only; this records a claim, not a dispatch.
ORIA_OPENHANDS_LAUNCH_CONFIG=
ORIA_ENABLE_OPENHANDS_TOOL_REVIEW=0
# Server-owned JSON project bindings; reference handle files, never inline secrets.
ORIA_MEMEX_PROJECT_BINDINGS=
# Operator read-only benchmark opt-in; leave empty during normal operation.
HQ_MISSION_READONLY_LIVE=

# Operator-only SSH status probes: production opt-in does not grant written
# approval, bypass cloud-host refusal, authenticate a CLI, or emit a model call.
ORIA_ENABLE_HERMES_SSH_PROBE=0
ORIA_ENABLE_OPENHANDS_RUNNER_PROBE=0
# Optional SSH targets and identity FILE PATHS; never inline private key material.
ORIA_HERMES_SSH_HOST=
ORIA_HERMES_SSH_IDENTITY_FILE=
ORIA_OPENHANDS_RUNNER_SSH_HOST=
ORIA_OPENHANDS_RUNNER_SSH_IDENTITY_FILE=

# Server reservation ledger, disabled unless exactly 1. Does not grant emission.
HQ_CALL_RESERVATION=0
# Absolute path to a qualified, non-secret server capability catalog; unset fails closed.
ORIA_HQ_CHAT_CAPABILITIES_FILE=
# Optional server-only Nara catalog credential; presence does not authorize generation.
NARA_API_KEY=

# Absolute path to non-secret, workspace-bound runner probe operator approval.
# No configured file means no SSH. See docs/RUNNER-PROBE-OPERATOR-CONFIG.md.
ORIA_OPENHANDS_RUNNER_PROBE_CONFIG_FILE=

# Explicit, closed-by-default connection-evidence transport for confirm_launch
# on a host that can never run the SSH probe itself (e.g. Vercel). Unset keeps
# the SSH-only probe unchanged. "persisted" reads an operator-recorded
# attestation instead — never a fallback from a refused/revoked SSH probe.
ORIA_OPENHANDS_CONNECTION_EVIDENCE_TRANSPORT=
# Non-secret JSON: the approved workspace/provider/runner/container binding a
# "persisted" transport must match, plus its freshness bound. See
# runner-connection-evidence.ts and runner-connection-evidence-record.mjs.
ORIA_OPENHANDS_CONNECTION_EVIDENCE_BINDING=

# ── Michael HQ ethical billing (optional) ───────────────────────────────────
# Leave empty unless Stripe billing/metering is intentionally enabled.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_METER_EVENT_NAME=
